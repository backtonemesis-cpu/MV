rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MV uses Firebase Auth in the browser, but household finance data must never
    // be accessed directly by browser Firestore clients. All household reads and
    // writes go through the authenticated MV server API, where membership and role
    // authorization are enforced on every request.
    //
    // The future durable Firestore backend will use Firebase Admin on the server.
    // Firebase Admin bypasses client security rules, so this file intentionally
    // keeps all browser/mobile Firestore access fail-closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
