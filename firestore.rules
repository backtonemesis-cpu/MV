rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function isBootstrapOwnerIdentity() {
      return hasVerifiedEmail() && request.auth.token.email == 'backtonemesis@gmail.com';
    }

    function profileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApprovedMember(householdId) {
      return profileExists()
        && profile().status == 'approved'
        && profile().householdId == householdId
        && profile().role in ['owner', 'editor', 'viewer'];
    }

    function canEditHousehold(householdId) {
      return isApprovedMember(householdId)
        && profile().role in ['owner', 'editor'];
    }

    function isHouseholdOwner(householdId) {
      return isApprovedMember(householdId)
        && profile().role == 'owner';
    }

    function hasRequiredProfileFields() {
      return request.resource.data.keys().hasAll([
        'email', 'displayName', 'status', 'role', 'householdId', 'createdAt', 'lastAccessAt'
      ]) && request.resource.data.keys().hasOnly([
        'email', 'displayName', 'status', 'role', 'householdId', 'createdAt', 'lastAccessAt'
      ]);
    }

    function validSelfProfileCreate(userId) {
      return hasVerifiedEmail()
        && request.auth.uid == userId
        && hasRequiredProfileFields()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastAccessAt == request.time
        && (
          (
            isBootstrapOwnerIdentity()
            && request.resource.data.status == 'approved'
            && request.resource.data.role == 'owner'
            && request.resource.data.householdId == 'mv-primary'
          ) || (
            !isBootstrapOwnerIdentity()
            && request.resource.data.status == 'pending'
            && request.resource.data.role == 'pending'
            && request.resource.data.householdId == null
          )
        );
    }

    function validOwnerMembershipUpdate(userId) {
      return isHouseholdOwner('mv-primary')
        && userId != request.auth.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.lastAccessAt == resource.data.lastAccessAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'role', 'householdId'
        ])
        && (
          (
            request.resource.data.status == 'approved'
            && request.resource.data.role in ['editor', 'viewer']
            && request.resource.data.householdId == 'mv-primary'
          ) || (
            request.resource.data.status == 'removed'
            && request.resource.data.role == 'removed'
            && request.resource.data.householdId == null
          ) || (
            request.resource.data.status == 'pending'
            && request.resource.data.role == 'pending'
            && request.resource.data.householdId == null
          )
        );
    }

    function validRecordShape() {
      return request.resource.data.keys().hasAll([
          'kind', 'monthKey', 'amountPence', 'description', 'revision',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.kind in [
          'income', 'fixed-bill', 'spending', 'refund',
          'internal-transfer', 'savings-transfer', 'card-repayment'
        ]
        && request.resource.data.monthKey is string
        && request.resource.data.monthKey.matches('^\\d{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.amountPence is int
        && request.resource.data.amountPence >= 0
        && request.resource.data.description is string
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1;
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isHouseholdOwner('mv-primary'));

      allow create: if validSelfProfileCreate(userId);

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'lastAccessAt'
        ])
        && request.resource.data.email == resource.data.email
        && request.resource.data.status == resource.data.status
        && request.resource.data.role == resource.data.role
        && request.resource.data.householdId == resource.data.householdId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastAccessAt == request.time;

      allow update: if validOwnerMembershipUpdate(userId);
      allow delete: if false;
    }

    match /households/{householdId} {
      allow read: if isApprovedMember(householdId);

      allow create: if householdId == 'mv-primary'
        && isBootstrapOwnerIdentity()
        && profileExists()
        && profile().role == 'owner'
        && profile().status == 'approved'
        && profile().householdId == householdId
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if isHouseholdOwner(householdId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);

      allow delete: if false;

      match /records/{recordId} {
        allow read: if isApprovedMember(householdId);

        allow create: if canEditHousehold(householdId)
          && validRecordShape()
          && request.resource.data.revision == 1
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if canEditHousehold(householdId)
          && validRecordShape()
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if canEditHousehold(householdId);
      }

      match /audit/{auditId} {
        allow read: if isApprovedMember(householdId);
        allow create: if canEditHousehold(householdId)
          && request.resource.data.keys().hasAll([
            'actorUid', 'action', 'entityType', 'entityId', 'createdAt'
          ])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.action is string
          && request.resource.data.entityType is string
          && request.resource.data.entityId is string
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
