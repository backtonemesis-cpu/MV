# Environment configuration for MV Household Finance
PORT=3000
NODE_ENV=development

# Local development remains SQLite by default.
# Production Cloud Run cutover must explicitly set firestore.
MV_DATA_BACKEND=sqlite

# MV authoritative production data uses only the stable default Firestore DB.
MV_FIRESTORE_DATABASE_ID=(default)

# Used explicitly by emulator/dev tooling. Cloud Run production normally resolves
# the project through Application Default Credentials.
GOOGLE_CLOUD_PROJECT=regal-campus-198sv
